FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DAGSTER_HOME=/opt/dagster/dagster_home

WORKDIR /app

COPY docker/requirements-dagster.txt .
RUN pip install --no-cache-dir -r requirements-dagster.txt

RUN mkdir -p $DAGSTER_HOME && touch $DAGSTER_HOME/dagster.yaml

COPY dlt_pipeline/ dlt_pipeline/
COPY dbt_project/ dbt_project/
COPY orchestration/ orchestration/

EXPOSE 3000

CMD ["dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-f", "orchestration/definitions.py"]
